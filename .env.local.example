# Neon (free) Postgres connection string
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js — generate with: npx auth secret   (or any 32+ char random string)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed on Vercel only if you use a custom domain; Vercel URLs are auto-trusted
# AUTH_TRUST_HOST=true

# Zerodha Kite Connect (Import & sync). Register the app at developers.kite.trade and set its
# redirect URL to <your-site>/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
# Any long random string; encrypts each user's Kite access token at rest
KITE_TOKEN_ENC_KEY=
